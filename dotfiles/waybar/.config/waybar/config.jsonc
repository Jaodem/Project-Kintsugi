{
    "layer": "top",
    "position": "top",
    "style": "~/.config/waybar/style.css",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "bluetooth",
        "hyprland/language",
        "custom/cpu",
        "custom/memory",
        "battery",
        "custom/weather",
        "clock",
        "tray"
    ],
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{0:%A %d/%m/%Y}\n{0:%H:%M:%S}",
        "on-click": "~/.config/waybar/scripts/calendar-popup.py"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-disabled": "󰤮",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-wifi": "Wi-Fi: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Ethernet\nIP: {ipaddr}\nGateway: {gwaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-disabled": "Network disabled",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "tooltip-format": "{node_name}\nVolume: {volume}%",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "bluetooth": {
        "format": "",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Bluetooth: connected\nDevices:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  • {device_alias}",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "blueman-manager"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "Eng",
        "format-es": "Lat",
        "on-click": "hyprctl switchxkblayout all next"
    },
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "interval": 2,
        "return-type": "json"
    },
    "custom/memory": {
        "exec": "~/.config/waybar/scripts/memory.sh",
        "interval": 5,
        "return-type": "json"
    },
    "battery": {
        "format": "{icon}",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹",
        "format-warning": "{icon} {capacity}%",
        "format-critical": "󰂃 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip-format": "Battery: {capacity}%\nPower: {power} W\nTime: {time}",
        "on-click": "~/.config/waybar/scripts/power-profile.sh",
        "events": {
            "on-discharging-warning": "notify-send -u normal -a Battery 'Low Battery' 'Less than 20% remaining'",
            "on-discharging-critical": "notify-send -u critical -a Battery 'Critical Battery' 'Less than 10% remaining'",
            "on-discharging-5": "notify-send -u critical -a Battery 'Critical Battery' 'Suspending in 45 seconds...' && sleep 45 && systemctl suspend"
        }
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "interval": 1800,
        "return-type": "json",
        "tooltip": true
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    }
}
