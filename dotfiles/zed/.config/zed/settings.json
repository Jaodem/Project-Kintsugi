// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "allow_all": "on"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "mode": "eager",
    "provider": "copilot"
  },
  "disable_ai": false,
  "features": {
    "copilot": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "terminal_init_command": "",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "prettier": {
    "allowed": true
  },
  "icon_theme": "Material Icon Theme",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark"
  },
  "ui_font_family": "Ubuntu",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_fallbacks": [],
  "terminal": {
    "font_family": "JetBrains Mono",
    "font_fallbacks": []
  }
}
